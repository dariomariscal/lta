---
// SpecList — la firma del sitio: ficha técnica en monoespaciada.
// Regla horizontal superior (como un plano), etiqueta fija 128px, valor a la derecha.
// Crece sin rediseño: se agregan filas cuando lleguen m², montos y fechas.
interface Props {
  rows: { k: string; v: string }[];
  light?: boolean;
  /** Activa el line-mask (valores que suben tras la regla) al entrar al viewport. */
  animate?: boolean;
}
const { rows, light = false, animate = false } = Astro.props;
---

<div class:list={['spec mono', { 'spec--light': light }]} data-reveal-spec={animate ? '' : undefined}>
  {
    rows.map((r) => (
      <div class="spec__row">
        <span class="spec__k">{r.k}</span>
        <span class="spec__v">{r.v}</span>
      </div>
    ))
  }
</div>

<style>
  .spec {
    border-top: 1px solid var(--line-2);
    padding-top: var(--s2);
  }
  .spec__row {
    display: flex;
    gap: var(--s2);
    padding-block: 6px;
  }
  .spec__k {
    flex: 0 0 128px;
    color: var(--concrete-3);
  }
  .spec__v {
    color: var(--concrete);
  }
  .spec--light .spec__k {
    color: #7a7873;
  }
  .spec--light .spec__v {
    color: var(--ink);
  }
</style>
