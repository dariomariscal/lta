---
// Hero — layout dividido: texto a la izquierda, imagen a la derecha. En móvil
// una sola columna: el texto va primero y la imagen debajo. Text reveal con
// máscara en el titular.
// Franja de estadísticas en mono. Un solo CTA primario.
import Button from './Button.astro';
import SpecList from './SpecList.astro';

interface Props {
  eyebrow: string;
  title: string;
  sub: string;
  image: { sector: string; slug: string; alt: string };
  cta: { href: string; label: string };
  stats?: { k: string; v: string }[];
}
const { eyebrow, title, sub, image, cta, stats } = Astro.props;
const base = `/img/${image.sector}/${image.slug}`;
// El título puede traer saltos de línea explícitos (\n) para fijar cómo se
// reparte en renglones y que NO cambie con el ancho de la pantalla. Cada línea
// se marca con data-line para que la animación de reveal respete esos saltos.
const titleLines = title.split('\n');
---

<section class="hero">
  <div class="hero__in wrap">
    <div class="hero__copy">
      <span class="mono eyebrow">{eyebrow}</span>
      <h1 class="display hero__title" data-reveal-text>
        {titleLines.map((line, i) => (
          <span class="hero__title-line" data-line>{i > 0 && <br />}{line}</span>
        ))}
      </h1>
      <p class="lede hero__sub" data-reveal>{sub}</p>
      <div class="hero__cta" data-reveal>
        <Button href={cta.href} variant="solid">{cta.label}</Button>
      </div>
      {stats && stats.length > 0 && (
        <div class="hero__stats">
          <SpecList rows={stats} animate />
        </div>
      )}
    </div>

    <figure class="hero__media chamfer-photo" data-reveal>
      <img
        class="hero__img"
        src={`${base}-1600.webp`}
        srcset={`${base}-800.webp 800w, ${base}-1600.webp 1600w`}
        sizes="(max-width: 900px) 100vw, 48vw"
        width="1563"
        height="886"
        alt={image.alt}
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--s6) var(--s5);
    overflow: hidden;
  }
  .hero__in {
    display: grid;
    grid-template-columns: 1fr 48%;
    gap: var(--s5);
    align-items: center;
  }
  .hero__copy {
    /* La columna de texto no se estira más de lo cómodo de leer. */
    max-width: 640px;
  }
  .eyebrow {
    display: block;
    margin-bottom: var(--s2);
  }
  .hero__title {
    margin-bottom: var(--s3);
    /* Equilibra por si acaso, pero los saltos reales los fijan los <br>. */
    text-wrap: balance;
  }
  /* Cada línea del título ocupa su propio renglón (el <br> ya la separa) y no
     se parte por dentro: así el titular siempre conserva los mismos renglones
     definidos en la página, sin importar el ancho de la pantalla. El clamp del
     .display reduce el tamaño en pantallas estrechas para que quepa. */
  .hero__title-line {
    display: inline;
    white-space: nowrap;
  }
  .hero__sub {
    max-width: 52ch;
    margin-bottom: var(--s4);
    color: var(--concrete-2);
  }
  .hero__cta {
    margin-bottom: var(--s5);
  }
  .hero__stats :global(.spec) {
    max-width: 640px;
  }

  /* Panel de imagen: foto biselada sobre panel rojo, como la portada del Book.
     El rojo asoma en las esquinas cortadas → marco diagonal de marca. */
  .hero__media {
    position: relative;
    margin: 0;
    background: var(--ink-3);
  }
  /* Panel rojo de fondo, ligeramente mayor: se ve por los chaflanes de la foto. */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: -3px;
    background: var(--red);
    clip-path: polygon(var(--chamfer) 0, 100% 0, 100% calc(100% - var(--chamfer)),
                       calc(100% - var(--chamfer)) 100%, 0 100%, 0 var(--chamfer));
    z-index: -1;
  }
  .hero__img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1563 / 886;
    object-fit: cover;
    object-position: 50% 45%;
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: var(--s5) var(--s4);
    }
    .hero__in {
      grid-template-columns: 1fr;
      gap: var(--s4);
    }
    /* En móvil el texto va primero (orden natural del DOM); la imagen queda
       debajo del copy. */
    .hero__copy {
      max-width: none;
    }
  }
</style>
