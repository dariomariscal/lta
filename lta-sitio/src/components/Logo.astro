        <linearGradient id={`${uid}-red`} gradientUnits="userSpaceOnUse" x1="155.32" y1="123.77" x2="155.32" y2="50.30">
          <stop offset="0" stop-color="#D2976B" />
          <stop offset="0.1701" stop-color="#C76E4A" />
          <stop offset="0.69" stop-color="#B83D27" />
        </linearGradient>
      </defs>
    )
  }

