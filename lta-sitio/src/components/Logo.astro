---
// Logo — marca oficial LTA como componente de UI reutilizable.
// Convertido del SVG oficial (LTA logo principal.svg) a paths controlables.
//
// El logo es la única excepción a la regla "cero degradados" del sistema: los
// biseles de marca son parte de la identidad. Para contextos donde el degradado
// no encaja (fondos oscuros, usos a una tinta) existe tone="mono".
//
// Variantes:
//   variant="mark"     → solo el isotipo (las letras LTA entrelazadas)
//   variant="lockup"   → isotipo + cintillos "CONSTRUCCIÓN / Y MANTENIMIENTO"
// Tonos:
//   tone="brand"       → degradados negros + asta terracota (marca original)
//   tone="mono"        → una sola tinta vía currentColor (hereda color del texto)
//
// Los IDs de los degradados se prefijan por instancia (uid) para permitir varias
// copias del logo en una misma página sin colisión de <linearGradient>.

interface Props {
  variant?: 'mark' | 'lockup';
  tone?: 'brand' | 'mono';
  /** Altura en px; el ancho se ajusta por proporción. */
  height?: number;
  /** Texto accesible; por defecto describe la marca. */
  title?: string;
  class?: string;
}

const {
  variant = 'mark',
  tone = 'brand',
  height = 30,
  title = 'LTA Construcción y Mantenimiento',
  class: cls = '',
} = Astro.props;

// viewBox: el isotipo vive en la franja superior; los cintillos abajo.
// Recortamos el alto del viewBox según la variante para que no quede aire.
const VB_W = 294.8;
const vb = variant === 'lockup' ? `0 0 ${VB_W} 192.76` : `0 0 ${VB_W} 125.42`;
const ratio = variant === 'lockup' ? 192.76 / VB_W : 125.42 / VB_W;
const width = +(height / ratio).toFixed(2);

// UID único por instancia para los IDs de gradiente: un contador global
// garantiza que dos logos en la misma página no colisionen sus <defs>.
const g = globalThis as any;
g.__ltaLogoCount = (g.__ltaLogoCount ?? 0) + 1;
const uid = `lta-logo-${g.__ltaLogoCount}`;

const grad = tone === 'mono';
const monoFill = 'currentColor';
---

<svg
  viewBox={vb}
  role="img"
  aria-label={title}
  width={width}
  height={height}
  class:list={['logo', `logo--${variant}`, `logo--${tone}`, cls]}
  xmlns="http://www.w3.org/2000/svg"
>
  <title>{title}</title>

  {
    !grad && (
      <defs>
        {/* Degradados negros de los biseles del isotipo */}
        <linearGradient id={`${uid}-g1`} gradientUnits="userSpaceOnUse" x1="165.93" y1="112.41" x2="263.56" y2="112.41">
          <stop offset="0.0025" stop-color="#262626" />
          <stop offset="0.1846" stop-color="#1A1A1A" />
          <stop offset="0.3909" stop-color="#0F0F0F" />
          <stop offset="0.6243" stop-color="#000000" />
        </linearGradient>
        <linearGradient id={`${uid}-g2`} gradientUnits="userSpaceOnUse" x1="186.58" y1="39.93" x2="68.22" y2="-28.40">
          <stop offset="0.0025" stop-color="#262626" />
          <stop offset="0.1846" stop-color="#1A1A1A" />
          <stop offset="0.3909" stop-color="#0F0F0F" />
          <stop offset="0.6243" stop-color="#000000" />
        </linearGradient>
        <linearGradient id={`${uid}-g3`} gradientUnits="userSpaceOnUse" x1="61.79" y1="52.84" x2="102.15" y2="73.41">
          <stop offset="0.0366" stop-color="#262626" />
          <stop offset="0.2353" stop-color="#1A1A1A" />
          <stop offset="0.4291" stop-color="#0F0F0F" />
          <stop offset="0.6243" stop-color="#000000" />
        </linearGradient>
        <linearGradient id={`${uid}-g4`} gradientUnits="userSpaceOnUse" x1="96.98" y1="96.24" x2="12.74" y2="144.87">
          <stop offset="0.0025" stop-color="#262626" />
          <stop offset="0.2333" stop-color="#1A1A1A" />
          <stop offset="0.4245" stop-color="#0F0F0F" />
          <stop offset="0.6243" stop-color="#000000" />
        </linearGradient>
        <linearGradient id={`${uid}-g5`} gradientUnits="userSpaceOnUse" x1="71.15" y1="12.71" x2="39.09" y2="68.24">
          <stop offset="0.0025" stop-color="#262626" />
