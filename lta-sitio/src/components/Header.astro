---
// Header — contenedor de la cabecera del sitio. Compone la marca, la
// navegación de escritorio (Navbar), el botón hamburguesa (NavToggle) y el
// menú móvil a pantalla completa (MobileMenu).
//
// El MobileMenu se monta como HERMANO del <header> (no dentro) para que su
// overlay fijo cubra la pantalla completa sin quedar atrapado en el contexto
// de apilamiento del header sticky. Ver notas en MobileMenu.astro.
import Logo from './Logo.astro';
import Navbar from './Navbar.astro';
import NavToggle from './NavToggle.astro';
import MobileMenu from './MobileMenu.astro';
---

<header class="site-head">
  <div class="site-head__in wrap">
    <a class="brand" href="/" aria-label="LTA — Inicio">
      <Logo variant="mark" height={48} />
    </a>

    <Navbar />
    <NavToggle controls="mobile-menu" />
  </div>
</header>

<MobileMenu />

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 78px;
    /* Velo del mismo off-white del fondo (250,248,244) — evita una banda de
       blanco puro más brillante que el resto de la página al hacer scroll. */
    background: rgba(250, 248, 244, 0.92);
    backdrop-filter: saturate(160%) blur(6px);
    border-bottom: 1px solid var(--line);
    transition: background var(--dur) var(--ease);
  }
  /* Con el menú abierto: el header se funde con el overlay opaco. Quitamos el
     backdrop-filter — que crea un plano de composición propio y dejaba al
     overlay fijo pintarse por encima de la marca y el botón — y volvemos el
     fondo transparente para que la barra (logo + aspa) quede visible sobre el
     overlay off-white, sin costura ni borde. */
  .site-head.is-open {
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .site-head__in {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 2;
  }
  /* CLAVE del apilamiento fiable en cualquier posición de scroll:
     el header es `sticky` (posición de flujo abajo tras el scroll), mientras
     que el overlay es `fixed` (siempre anclado a la ventana). Comparar el
     z-index de un sticky contra un fixed es frágil: al hacer scroll, el overlay
     fijo se pinta sobre la posición de flujo del header y tapa marca + botón.

     Solución: con el menú abierto, sacamos la barra (logo + aspa) del flujo del
     header y la fijamos nosotros mismos a la ventana. Así comparte el mismo
     modo de posicionamiento que el overlay (`fixed` vs `fixed`) y su z-index
     mayor gana de forma determinista, sin importar cuánto se haya bajado. */
  .site-head.is-open .site-head__in {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 78px;
    z-index: 60; /* por encima del overlay (.mobile-menu z-45) */
  }
  .brand {
    display: flex;
    align-items: center;
    transition: opacity var(--dur) var(--ease);
  }
  .brand :global(svg) {
    display: block;
  }
  .brand:hover {
    opacity: 0.82;
  }
</style>
