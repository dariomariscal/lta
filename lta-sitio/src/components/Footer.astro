---
// Footer — tres columnas: empresa, mapa del sitio, contacto.
// Datos verificados de lta-docs/docs/02-contenido.
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="wrap grid8 site-foot__grid">
    <div class="site-foot__col site-foot__about">
      <a class="brand-foot" href="/" aria-label="LTA Construcción y Mantenimiento — Inicio">
        <Logo variant="lockup" height={128} />
      </a>
      <p class="body">
        LTA Construcción y Mantenimiento, unidad de Grupo Industrial LTA.
        Contratista mexicana que ejecuta y mantiene obra por encargo de terceros,
        con cobertura nacional.
      </p>
      <p class="mono site-foot__mv">
        Compromiso · Respeto · Igualdad y equidad · Lealtad · Honestidad · Responsabilidad
      </p>
    </div>

    <nav class="site-foot__col" aria-label="Mapa del sitio">
      <p class="mono site-foot__h">Sitio</p>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/servicios">Servicios</a></li>
        <li><a href="/proyectos">Proyectos</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
    </nav>

    <div class="site-foot__col">
      <p class="mono site-foot__h">Contacto</p>
      <ul class="site-foot__contact">
        <li><a href="tel:+525589510107">55 8951 0107</a></li>
        <li><a href="tel:+525589510108">55 8951 0108</a></li>
        <li><a href="mailto:contacto@grupolta.com">contacto@grupolta.com</a></li>
        <li><a href="mailto:servicioacliente@grupolta.com">servicioacliente@grupolta.com</a></li>
        <li class="site-foot__hours">Lun–Vie 9:00–19:00 · Sáb 9:00–13:00</li>
        <li class="site-foot__hours">Ciudad de México</li>
      </ul>

      <ul class="site-foot__social" aria-label="Redes sociales">
        <li>
          <a
            href="https://www.instagram.com/grupo.industrial.lta/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de LTA"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </li>
        <li>
          <a
            href="https://www.facebook.com/profile.php?id=61567447994676"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook de LTA"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M14.5 8.5V6.9c0-.8.2-1.2 1.3-1.2h1.5V2.8c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2H8.5v3h2.9V21h3.1v-9.5h2.6l.4-3h-3z" />
            </svg>
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/company/lta-construcci%C3%B3n-y-mantenimiento/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn de LTA"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M6.5 8.5H3.6V21h2.9V8.5zM5 3.3A1.7 1.7 0 105 6.7a1.7 1.7 0 000-3.4zM21 21h-2.9v-6.1c0-1.5-.5-2.5-1.8-2.5-1 0-1.6.7-1.8 1.3-.1.2-.1.5-.1.9V21H11.5s.04-11.3 0-12.5h2.9v1.8c.4-.6 1.1-1.5 2.7-1.5 2 0 3.5 1.3 3.5 4.1V21z" />
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap site-foot__bar mono">
    <span>© {year} Grupo Industrial LTA</span>
    <span>Dir. Gral. Ing. Alfonso Téllez Patiño</span>
  </div>
</footer>

<style>
  .site-foot {
    position: relative;
    background: var(--ink-2);
    border-top: 1px solid var(--line);
    padding-top: var(--s6);
  }
  .site-foot__grid {
    row-gap: var(--s4);
  }
  .site-foot__about {
    grid-column: span 4;
  }
  .site-foot__col:not(.site-foot__about) {
    grid-column: span 2;
  }
  .brand-foot {
    display: inline-block;
    margin-bottom: var(--s3);
    transition: opacity var(--dur) var(--ease);
  }
  .brand-foot:hover {
    opacity: 0.82;
  }
  .brand-foot :global(svg) {
    display: block;
  }
  .site-foot__about .body {
    color: var(--concrete-3);
    margin-bottom: var(--s3);
  }
  .site-foot__mv {
    color: var(--concrete-4);
    line-height: 1.8;
  }
  .site-foot__h {
    color: var(--concrete-4);
    margin-bottom: var(--s2);
  }
  .site-foot__col li {
    margin-bottom: var(--s1);
  }
  .site-foot__col a {
    color: var(--concrete-2);
    transition: color var(--dur) var(--ease);
  }
  .site-foot__col a:hover {
    color: var(--red-2);
  }
  .site-foot__hours {
    color: var(--concrete-4);
    font-size: 15px;
  }
  .site-foot__social {
    display: flex;
    gap: var(--s2);
    margin-top: var(--s3);
  }
  .site-foot__social li {
    margin-bottom: 0;
  }
  .site-foot__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--concrete-2);
    border: 1px solid var(--line);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .site-foot__social a:hover {
    color: var(--red-2);
    border-color: var(--red-2);
  }
  .site-foot__bar {
    margin-top: var(--s6);
    padding-block: var(--s3);
    border-top: 1px solid var(--line);
    display: flex;
    gap: var(--s4);
    flex-wrap: wrap;
    color: var(--concrete-4);
  }
  @media (max-width: 900px) {
    .site-foot__about,
    .site-foot__col:not(.site-foot__about) {
      grid-column: 1;
    }
  }
</style>
