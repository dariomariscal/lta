---
// Coverage — retícula de 9 estados con numeral en rojo. Sin mapa SVG: el
// tratamiento tipográfico es más honesto y coherente con la estética técnica.
const estados = [
  'Ciudad de México', 'Estado de México', 'Michoacán',
  'Quintana Roo', 'Nayarit', 'Guerrero',
  'Oaxaca', 'Chiapas', 'Sinaloa',
];
---

<ul class="coverage" data-reveal-group>
  {
    estados.map((e, i) => (
      <li class="coverage__cell" data-reveal>
        <span class="mono numeral">{String(i + 1).padStart(2, '0')}</span>
        <span class="coverage__name">{e}</span>
      </li>
    ))
  }
</ul>

<style>
  .coverage {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .coverage__cell {
    background: var(--ink);
    padding: var(--s3);
    display: flex;
    flex-direction: column;
    gap: var(--s1);
    min-height: 128px;
    justify-content: space-between;
  }
  .coverage__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1;
    text-transform: uppercase;
  }
  @media (max-width: 640px) {
    .coverage {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
