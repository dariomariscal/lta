---
// ProcessSteps — "Cómo trabajamos": 4 pasos en retícula horizontal. Solo texto.
interface Props {
  steps: { num: string; title: string; text: string }[];
}
const { steps } = Astro.props;
---

<ol class="process" data-reveal-group>
  {
    steps.map((s) => (
      <li class="process__step" data-reveal>
        <span class="mono numeral">{s.num}</span>
        <h3 class="process__title">{s.title}</h3>
        <p class="body">{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .process {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .process__step {
    background: var(--ink);
    padding: var(--s3);
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }
  .process__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 23px;
    line-height: 1.05;
  }
  .process__step .body {
    color: var(--concrete-3);
  }
  @media (max-width: 900px) {
    .process {
      grid-template-columns: 1fr;
    }
  }
</style>
