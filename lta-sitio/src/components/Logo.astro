          <stop offset="0.3588" stop-color="#0F0F0F" />
          <stop offset="0.6243" stop-color="#000000" />
        </linearGradient>
        <linearGradient id={`${uid}-g6`} gradientUnits="userSpaceOnUse" x1="227.61" y1="125.10" x2="227.61" y2="1.16">
