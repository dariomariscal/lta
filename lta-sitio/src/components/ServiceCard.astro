---
// ServiceCard — celda de servicio. Numeral en mono + título + descripción.
// Imagen opcional con grayscale que recupera color en hover.
import Picture from './Picture.astro';
interface Props {
  num: string;
  title: string;
  text: string;
  image?: { sector: string; slug: string; alt: string };
}
const { num, title, text, image } = Astro.props;
---

<article class="svc__item" data-reveal>
  {
    image && (
      <div class="svc__media media-box chamfer-photo">
        <Picture
          sector={image.sector}
          slug={image.slug}
          alt={image.alt}
          width={800}
          height={600}
          class="svc__img"
        />
      </div>
    )
  }
  <div class="svc__body">
    <span class="mono svc__num">{num}</span>
    <h3>{title}</h3>
    <p class="body">{text}</p>
  </div>
</article>

<style>
  .svc__item {
    background: var(--ink-2);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
  }
  .svc__media {
    /* Misma altura en todas las tarjetas: LTA quiere que todas las imágenes
       midan lo mismo aunque se recorten (nada de alturas dispares ni franjas
       grises). Usamos aspect-ratio para que la altura sea idéntica en toda la
       fila sin importar el ancho de columna; la imagen cubre con object-fit. */
    aspect-ratio: 4 / 3;
    flex-shrink: 0;
    overflow: hidden;
  }
  /* El <img> viene de Picture.astro, así que NO lleva el data-astro-cid de
     este componente; un selector scoped normal no lo alcanza. Usamos :global()
     acotado a .svc__media para forzar que la imagen llene la caja (si no,
     conserva su alto natural con object-fit:fill y las tarjetas quedan
     disparejas). */
  .svc__media :global(.svc__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.42) contrast(1.02);
    transition: filter var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease);
  }
  .svc__item:hover :global(.svc__img) {
    filter: grayscale(0);
    transform: scale(1.03);
  }
  .svc__body {
    padding: var(--s3);
    display: flex;
    flex-direction: column;
    gap: var(--s1);
    flex: 1;
  }
  .svc__num {
    color: var(--concrete-4);
  }
  .svc__body h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.05;
  }
  .svc__body .body {
    color: var(--concrete-3);
  }
</style>
