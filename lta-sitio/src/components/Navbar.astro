---
// Navbar — navegación horizontal de escritorio (enlaces + CTA en línea).
// Se oculta bajo 900px, donde la navegación pasa al MobileMenu a pantalla completa.
import { navLinks, navCta, isActive } from '@/data/nav-links';
const pathname = Astro.url.pathname;
---

<nav class="nav-desk mono" aria-label="Principal">
  {
    navLinks.map((l) => (
      <a href={l.href} aria-current={isActive(l.href, pathname) ? 'page' : undefined}>
        {l.label}
      </a>
    ))
  }
  <a class="btn mono nav-desk__cta" href={navCta.href}>{navCta.label}</a>
</nav>

<style>
  .nav-desk {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }
  .nav-desk a {
    /* Mismo carácter fuerte que los enlaces del menú móvil (.display):
       tipografía condensada display con peso bold, a tamaño de barra. */
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.01em;
    color: var(--concrete-2);
    transition: color var(--dur) var(--ease);
  }
  /* El CTA se excluye: tiene su propio hover (fondo rojo + texto claro). Sin
     esta exclusión, este `color: red` empataría en especificidad con el del
     botón y, según el orden de fuente, podía pintar texto rojo sobre fondo
     rojo — ilegible. */
  .nav-desk a:not(.nav-desk__cta):hover,
  .nav-desk a[aria-current='page'] {
    color: var(--red-2);
  }
  .nav-desk__cta {
    color: var(--concrete);
  }
  .btn {
    border: 1px solid var(--red);
    padding: 9px 18px;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  a.btn:hover {
    background: var(--red);
    color: var(--on-red);
  }

  @media (max-width: 900px) {
    .nav-desk {
      display: none;
    }
  }
</style>
